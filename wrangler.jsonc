{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osaka-trip",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osaka-trip",
      "database_id": "21cd5e95-8e5e-441c-b3e9-313deba6f3c7"
    }
  ]
}
